      {
        "selector": "JSXOpeningElement[name.name='SectionBreak'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:asterism|rule)$/]",
        "message": "<SectionBreak> variant must be one of 'asterism' | 'rule'."
