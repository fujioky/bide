{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/data/**",
              "components/icons/**",
              "components/interactive/**",
              "components/shell/**",
              "ui_kits/blog/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Space Grotesk|Newsreader|Playfair Display|JetBrains Mono|Fira Code|IBM Plex Mono|Noto Sans SC|Noto Serif SC))/i]",
        "message": "Font not provided by the design system. Available: Inter, Space Grotesk, Newsreader, Playfair Display, JetBrains Mono, Fira Code, IBM Plex Mono, Noto Sans SC, Noto Serif SC."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|summary|category|date|tags|readTime|variant|cover|hidden|feature|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ArticleCard> doesn't accept that prop. Declared props: title, summary, category, date, tags, readTime, variant, cover, hidden, feature, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|cover|row)$/]",
        "message": "<ArticleCard> variant must be one of 'default' | 'cover' | 'row'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|kicker|align|serif|style|key|ref|className|style|children)$/]",
        "message": "<ArticleHeader> doesn't accept that prop. Declared props: title, meta, kicker, align, serif, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleHeader'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<ArticleHeader> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarChartRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|max|display|tone|style|key|ref|className|style|children)$/]",
        "message": "<BarChartRow> doesn't accept that prop. Declared props: label, value, max, display, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarChartRow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|up|down|quiet)$/]",
        "message": "<BarChartRow> tone must be one of 'accent' | 'up' | 'down' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|full|disabled|icon|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, full, disabled, icon, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline|ghost|quiet)$/]",
        "message": "<Button> variant must be one of 'solid' | 'outline' | 'ghost' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|title|children|style|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: kind, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:tip|warning|danger|best)$/]",
        "message": "<Callout> kind must be one of 'tip' | 'warning' | 'danger' | 'best'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChartFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|note|height|children|style|key|ref|className|style|children)$/]",
        "message": "<ChartFrame> doesn't accept that prop. Declared props: title, note, height, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeToken'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|color|key|ref|className|style|children)$/]",
        "message": "<CodeToken> doesn't accept that prop. Declared props: text, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComparisonTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|zebra|align|style|key|ref|className|style|children)$/]",
        "message": "<ComparisonTable> doesn't accept that prop. Declared props: columns, rows, zebra, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DemoPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|title|focused|children|style|key|ref|className|style|children)$/]",
        "message": "<DemoPanel> doesn't accept that prop. Declared props: label, title, focused, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FigureImage'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|caption|ratio|bleed|rounded|style|key|ref|className|style|children)$/]",
        "message": "<FigureImage> doesn't accept that prop. Declared props: src, caption, ratio, bleed, rounded, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:mobile|showBackToTop|links|style|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: mobile, showBackToTop, links, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GrokLauncher'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|mobile|onClick|style|key|ref|className|style|children)$/]",
        "message": "<GrokLauncher> doesn't accept that prop. Declared props: label, mobile, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GrokMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:role|text|key|ref|className|style|children)$/]",
        "message": "<GrokMessage> doesn't accept that prop. Declared props: role, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='GrokMessage'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:ai|user)$/]",
        "message": "<GrokMessage> role must be one of 'ai' | 'user'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Header'] > JSXAttribute > JSXIdentifier[name!=/^(?:nav|admin|mobile|progress|hidden|sticky|style|key|ref|className|style|children)$/]",
        "message": "<Header> doesn't accept that prop. Declared props: nav, admin, mobile, progress, hidden, sticky, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LyraIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|style|key|ref|className|style|children)$/]",
        "message": "<LyraIcon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MathBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:tex|label|style|key|ref|className|style|children)$/]",
        "message": "<MathBlock> doesn't accept that prop. Declared props: tex, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: children, active, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Playground'] > JSXAttribute > JSXIdentifier[name!=/^(?:lang|code|output|editable|style|key|ref|className|style|children)$/]",
        "message": "<Playground> doesn't accept that prop. Declared props: lang, code, output, editable, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|cite|variant|style|key|ref|className|style|children)$/]",
        "message": "<PullQuote> doesn't accept that prop. Declared props: children, cite, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:rule|display)$/]",
        "message": "<PullQuote> variant must be one of 'rule' | 'display'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScrollProgress'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|style|key|ref|className|style|children)$/]",
        "message": "<ScrollProgress> doesn't accept that prop. Declared props: value, style."
